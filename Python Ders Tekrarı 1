# if ile karar verme
sayi1 = int(input("1.Sayıyı giriniz:"))
sayi2 = int(input("2.Sayıyı giriniz:"))
islem = input("İşleminiz nedir (+,-,*,/)?")
if islem == "+" :  # işlem değişkenin + ifadesinde eşit olması durumunda aşağıdaki kodu çalıştırır.
   toplam = sayi1 + sayi2
   print(f"{sayi1} + {sayi2} = {toplam}")
if islem == "-" :  # işlem değişkenin - ifadesinde eşit olması durumunda aşağıdaki kodu çalıştırır.
   cıkarma = sayi1 - sayi2
   print(f"{sayi1} - {sayi2} = {cıkarma}")
if islem == "*" :  # işlem değişkenin * ifadesinde eşit olması durumunda aşağıdaki kodu çalıştırır.
   carpma = sayi1 * sayi2
   print(f"{sayi1} * {sayi2} = {carpma}")
if islem == "/" :  # işlem değişkenin / ifadesinde eşit olması durumunda aşağıdaki kodu çalıştırır.
   bolme = sayi1 / sayi2
   print(f"{sayi1} / {sayi2} = {bolme}")
 
operatorler
# Aritmetik operatorler / Matematiksel operatorler
print(5+9) # + operatand
print("5" + "9") # + operator , 5 ile 9 operand birleştirme
print(5*9)
print(20/3)
print(20//3) # virgülsüz bölme
print(2**3) # üst alma
print(10**3) # üst alma
print(10%3) # mod alma
print(20%3) # mod alma
# String operatorleri
print("5" + "9") # + operand 5 ile 9 operand birleştirme
print("Vektorel" + "Bilisim")
print("Vektorel"*4)
# Mantıksal operatorler/Karşılaştırma opeatorler True/False sonucu üreten operatorlerdir
# True = Doğru = 1 = Evet = Olumlu
# False = Yanlış = 0 = Hayır = Olumsuz
print(3<8)
print(3>8)
print(3<=8) # küçük veya eşit mi
print(3>=8) # büyük veya eşit mi
print(3==8)
print(3==3)
print(3!=8) # eşit değil mi
print(3>8 or 15>12) # Sadece bir şartın doğru olması durumunda sonuc doğru olur
print(13>8 and 15>12) # Tüm şartların doğru olması durumunda sonuc doğru olur.





